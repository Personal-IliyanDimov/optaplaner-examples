<?xml version="1.0" encoding="UTF-8"?>
<!--
  Partitioned solve: CH + tabu per due-date partition, then diagnostics custom phase.
  Per-partition LS uses a time cap only (bestScoreLimit unsupported on PART_THREAD).
  No global localSearch — avoids cross-day expertSchedule moves on the merged solution.
  Non-partitioned: expert-schedule-solver-config.unpartitioned.xml
-->
<solver xmlns="https://www.optaplanner.org/xsd/solver" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://www.optaplanner.org/xsd/solver https://www.optaplanner.org/xsd/solver/solver.xsd">
  <moveThreadCount>NONE</moveThreadCount>

  <solutionClass>org.imd.expertschedule.planner.solution.ExpertPlanningSolution</solutionClass>
  <entityClass>org.imd.expertschedule.planner.domain.ScheduleItem</entityClass>

  <scoreDirectorFactory>
    <constraintProviderClass>org.imd.expertschedule.planner.cp.ExpertPlanningConstraintProvider</constraintProviderClass>
    <constraintStreamImplType>BAVET</constraintStreamImplType>
    <initializingScoreTrend>ONLY_DOWN</initializingScoreTrend>
  </scoreDirectorFactory>

  <termination>
    <spentLimit>PT45M00S</spentLimit>
  </termination>

  <partitionedSearch>
    <termination>
      <minutesSpentLimit>30</minutesSpentLimit>
    </termination>
    <solutionPartitionerClass>org.imd.expertschedule.planner.partition.ExpertSchedulePartitioner</solutionPartitionerClass>
    <runnablePartThreadLimit>AUTO</runnablePartThreadLimit>
    <constructionHeuristic>
      <termination>
        <terminationCompositionStyle>OR</terminationCompositionStyle>
        <spentLimit>PT10M00S</spentLimit>
        <bestScoreLimit>0hard/*medium/*soft</bestScoreLimit>
      </termination>
      <constructionHeuristicType>FIRST_FIT_DECREASING</constructionHeuristicType>
    </constructionHeuristic>
    <localSearch>
      <termination>
        <terminationCompositionStyle>OR</terminationCompositionStyle>
        <spentLimit>PT20M00S</spentLimit>
        <bestScoreLimit>0hard/*medium/*soft</bestScoreLimit>
      </termination>
      <localSearchType>TABU_SEARCH</localSearchType>
    </localSearch>
  </partitionedSearch>

  <customPhase>
    <customPhaseCommandClass>org.imd.expertschedule.planner.partition.PartitionDiagnosticsAfterPartitionedPhaseCommand</customPhaseCommandClass>
  </customPhase>
</solver>
